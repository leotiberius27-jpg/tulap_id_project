rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny untuk seluruh koleksi - termasuk `activity_reports`
    // & `asset_documents` yang ditulis backend lewat Firebase Admin SDK
    // (FirestoreSyncService), yang SELALU melewati Security Rules apa
    // pun isinya. Baris ini murni memastikan klien (mobile/web) TIDAK
    // BISA membaca/menulis koleksi tersebut secara langsung.
    //
    // Modul "Live Tracking (Firebase)" (live_locations/{userId}) yang
    // sebelumnya punya rule di sini sudah dihapus - fitur itu tidak
    // pernah punya konsumen produksi dan dicabut. Login "pintu depan"
    // via Firebase Authentication (lihat AuthService.loginWithFirebase
    // di backend) TETAP aktif dan tidak terpengaruh - itu cuma
    // memverifikasi identitas lewat Firebase Admin SDK, tidak pernah
    // bergantung pada Firestore Security Rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
