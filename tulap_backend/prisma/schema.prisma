// =====================================================================
// TULAP.ID - SKEMA DATABASE UTAMA
// =====================================================================
// Prisma Schema untuk PostgreSQL
// Mencakup: RBAC (User & Role), Task SPPD, Geotag Photo, Expense Note
// Kepatuhan: UU PDP No. 27/2022 - Data Center wajib di region Indonesia
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1. MODUL RBAC: ROLE & USER
// =====================================================================

/// Master data Role untuk keperluan Role-Based Access Control (RBAC)
model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

/// Enum daftar Role sesuai kebutuhan instansi pemerintah
enum RoleName {
  PEGAWAI // Staf lapangan - input tugas, foto, nota
  VERIFIKATOR // Atasan/Finance - verifikasi laporan
  ADMIN // Admin instansi - kelola user & konfigurasi
  SUPER_ADMIN // Admin pusat - kelola seluruh instansi/tenant

  @@map("role_name")
}

/// Data pengguna sistem (ASN, Tim Inspeksi, Staf Keuangan, dll)
model User {
  id           String   @id @default(uuid())
  nip          String?  @unique // Nomor Induk Pegawai (opsional utk non-ASN)
  fullName     String   @map("full_name")
  email        String   @unique
  phoneNumber  String?  @map("phone_number")
  // Nullable: akun yang dibuat lewat Google/Apple Sign-In tidak pernah
  // punya password lokal - login().checkPassword() menolak login
  // email/password untuk akun semacam ini dan mengarahkan ke tombol
  // OAuth yang sesuai (lihat AuthService.login).
  passwordHash String?  @map("password_hash")
  instansiName String?  @map("instansi_name") // Nama dinas/instansi
  unitKerja    String?  @map("unit_kerja") // Unit kerja/bagian
  photoUrl     String?  @map("photo_url") // URL foto profil di S3 (bukan path lokal device)

  // Registrasi mandiri (self-registration, Bagian baru: "Daftar" di
  // mobile) - dibedakan dari akun yang diprovisioning Admin lewat
  // POST /auth/register, murni untuk audit trail asal-usul akun.
  isSelfRegistered Boolean @default(false) @map("is_self_registered")

  // Sign-In with Google/Apple - id unik dari provider, dipakai mencari
  // akun yang sudah ditautkan tanpa bergantung ke email (email Google/
  // Apple bisa saja berubah, id provider tidak).
  googleId   String? @unique @map("google_id")
  appleId    String? @unique @map("apple_id")
  facebookId String? @unique @map("facebook_id")

  // Lupa Kata Sandi (Bagian baru mobile) - kode OTP 6-digit + waktu
  // kedaluwarsa, BUKAN token panjang, karena mobile belum punya deep
  // link/app-link setup - user menyalin kode dari email lalu
  // memasukkannya manual di app.
  passwordResetCodeHash String?   @map("password_reset_code_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi balik
  tasks           Task_SPPD[]      @relation("TaskAssignee")
  createdTasks    Task_SPPD[]      @relation("TaskCreator")
  geotagPhotos    Geotag_Photo[]
  expenseNotes    Expense_Note[]   @relation("ExpenseOwner")
  verifiedNotes   Expense_Note[]   @relation("ExpenseVerifier")
  auditLogs       Audit_Log[]
  notifications   Notification[]
  revisionNotes   Task_Revision_Note[]
  travelMissions  Travel_Mission[]
  subscription    Subscription?
  paymentTransactions PaymentTransaction[]
  deviceTokens    DeviceToken[]

  @@index([roleId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

// =====================================================================
// 2. MODUL TUGAS DINAS (SPPD)
// =====================================================================

/// Enum status siklus hidup tugas SPPD
enum TaskStatus {
  DRAFT // Baru dibuat, belum berjalan
  ONGOING // Sedang berlangsung di lapangan
  PENDING_VERIFICATION // Menunggu verifikasi Verifikator
  REVISION_NEEDED // Dikembalikan untuk perbaikan
  VERIFIED // Sudah diverifikasi/disetujui
  REJECTED // Ditolak
  COMPLETED // Selesai & LPJ terbit

  @@map("task_status")
}

/// Tabel utama pencatatan Surat Perintah Perjalanan Dinas (SPPD)
model Task_SPPD {
  id           String @id @default(uuid())
  taskCode     String @unique @map("task_code") // Nomor surat tugas/SPPD

  taskName    String @map("task_name")
  destination String // Lokasi/kota tujuan tugas
  description String?

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  budgetAmount    Decimal @map("budget_amount") @db.Decimal(15, 2)
  realizedAmount  Decimal @default(0) @map("realized_amount") @db.Decimal(15, 2)

  status TaskStatus @default(DRAFT)

  // Pegawai yang ditugaskan ke lapangan
  assigneeId String @map("assignee_id")
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  // Admin/atasan yang membuat penugasan
  creatorId String @map("creator_id")
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  // Kaitan ke Perjalanan Dinas (Travel Mission / Misi Induk)
  travelMissionId String? @map("travel_mission_id")
  travelMission   Travel_Mission? @relation(fields: [travelMissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi balik
  geotagPhotos Geotag_Photo[]
  expenseNotes Expense_Note[]
  checklistItems Task_Checklist_Item[]
  revisionNotes Task_Revision_Note[]

  @@index([assigneeId])
  @@index([creatorId])
  @@index([travelMissionId])
  @@index([status])
  @@index([startDate, endDate]) // Optimasi pencarian rentang tanggal
  @@map("task_sppd")
}

// =====================================================================
// 2B. MODUL CHECKLIST TUGAS
// =====================================================================

/// Item checklist per tugas - "Satu Tugas = Satu Folder Pintar" (Bagian
/// 7 dokumen spesifikasi). Ditentukan Admin saat membuat penugasan
/// (jenis bukti wajib apa saja), dicentang satu-per-satu oleh Pegawai
/// selagi bekerja di lapangan.
model Task_Checklist_Item {
  id String @id @default(uuid())

  taskId String    @map("task_id")
  task   Task_SPPD @relation(fields: [taskId], references: [id], onDelete: Cascade)

  label String // Contoh: "Datang ke lokasi", "Foto kondisi awal"
  order Int // Urutan tampil di UI (checklist berurutan, bukan acak)

  // Sebagian item WAJIB dipenuhi sebelum tugas bisa dikirim untuk
  // verifikasi (mis. "Foto kegiatan"), sebagian bersifat opsional
  // (mis. "Isi catatan tambahan").
  isMandatory Boolean @default(true) @map("is_mandatory")

  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@map("task_checklist_items")
}

// =====================================================================
// 3. MODUL BUKTI FOTO GEOTAG
// =====================================================================

/// Foto kegiatan lapangan dengan validasi lokasi & integritas file
model Geotag_Photo {
  id String @id @default(uuid())

  taskId String    @map("task_id")
  task   Task_SPPD @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploaderId String @map("uploader_id")
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  // Lokasi penyimpanan fisik file di S3-Compatible Storage (Region Jakarta)
  photoUrl String @map("photo_url")

  // Data Geotagging
  latitude       Decimal @db.Decimal(10, 7)
  longitude      Decimal @db.Decimal(10, 7)
  address        String? // Hasil reverse-geocoding

  // Timestamp WAJIB diambil dari server, bukan device, untuk mencegah rekayasa
  serverTimestamp DateTime @map("server_timestamp")

  // Keamanan & Integritas
  integrityHash     String  @map("integrity_hash") // SHA-256 checksum file asli
  isMockLocationFlag Boolean @default(false) @map("is_mock_location_flag") // Terdeteksi fake GPS
  isRootedDeviceFlag Boolean @default(false) @map("is_rooted_device_flag") // Terdeteksi root/jailbreak

  caption String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([uploaderId])
  @@index([serverTimestamp])
  @@map("geotag_photos")
}

// =====================================================================
// 4. MODUL NOTA/BUKTI PENGELUARAN
// =====================================================================

/// Enum kategori nota, mengacu kepada parser OCR retail lokal
enum ExpenseCategory {
  BBM // SPBU
  TOL
  PENGINAPAN // Hotel/penginapan
  RETAIL // Indomaret/Alfamart/minimarket
  KONSUMSI // Makan/minum
  TRANSPORTASI_LAIN // Taksi/ojek online/parkir
  LAINNYA

  @@map("expense_category")
}

/// Enum status verifikasi nota oleh Verifikator/Finance
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

/// Hasil digitalisasi nota fisik (scan + OCR) sebagai bukti pengeluaran
model Expense_Note {
  id String @id @default(uuid())

  taskId String    @map("task_id")
  task   Task_SPPD @relation(fields: [taskId], references: [id], onDelete: Cascade)

  ownerId String @map("owner_id") // Pegawai pemilik nota
  owner   User   @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Lokasi file scan nota di S3-Compatible Storage
  scanUrl String @map("scan_url")

  // Hasil ekstraksi OCR
  vendorName      String   @map("vendor_name")
  transactionDate DateTime @map("transaction_date")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(15, 2)
  category        ExpenseCategory
  ocrRawText      String?  @map("ocr_raw_text") // Teks mentah hasil OCR (untuk audit trail)
  ocrConfidence   Decimal? @map("ocr_confidence") @db.Decimal(5, 2) // Skor keyakinan OCR (0-100)

  // Verifikasi
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifierId         String?            @map("verifier_id")
  verifier            User?             @relation("ExpenseVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?          @map("verified_at")
  rejectionReason     String?            @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@index([ownerId])
  @@index([verifierId])
  @@index([verificationStatus])
  @@index([transactionDate]) // Optimasi rekap laporan per periode
  @@index([category])
  @@map("expense_notes")
}

// =====================================================================
// 5. MODUL AUDIT TRAIL
// =====================================================================

/// Log tindakan penting - append-only (Bagian 31 dokumen spesifikasi).
/// Tidak ada endpoint update/delete untuk model ini di mana pun -
/// hanya ditulis lewat AuditService.log(), tidak pernah diubah/dihapus.
model Audit_Log {
  id String @id @default(uuid())

  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action   String // Contoh: "TASK_CREATED", "TASK_APPROVED", "EVIDENCE_PHOTO_UPLOADED"
  entity   String // Contoh: "Task_SPPD", "Geotag_Photo"
  entityId String @map("entity_id")

  metadata Json? // Detail tambahan bebas bentuk per action (mis. catatan revisi)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
// 6. MODUL NOTIFIKASI
// =====================================================================

/// Sesuai tabel Notification System Bagian 25 dokumen spesifikasi.
enum NotificationType {
  TASK_ASSIGNED
  REVISION_NEEDED
  TASK_APPROVED
  TASK_REJECTED
  LPJ_READY

  @@map("notification_type")
}

model Notification {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  relatedTaskId String? @map("related_task_id")

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@map("device_platform")
}

/// DeviceToken
/// ----------------------------------------------------------------------
/// Token FCM per perangkat, dipakai NotificationsService.notify() untuk
/// mengirim push notification server-to-server (lihat
/// src/infrastructure/push/push-notification.service.ts) setiap kali
/// Notification baru dibuat. `token` unique (bukan per-user) karena satu
/// token fisik cuma boleh terikat ke SATU user aktif sekaligus - re-login
/// dengan akun lain di HP yang sama mengambil-alih token itu (upsert by
/// token, bukan insert baru).
/// ----------------------------------------------------------------------
model DeviceToken {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String         @unique
  platform DevicePlatform @default(ANDROID)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

// =====================================================================
// 7. MODUL CATATAN REVISI
// =====================================================================

/// Catatan spesifik Verifikator saat mengembalikan/menolak tugas -
/// mengisi kekosongan yang sebelumnya membuat Pegawai tidak tahu APA
/// yang perlu diperbaiki (Bagian 22: "Nota BBM - Nominal kurang jelas").
model Task_Revision_Note {
  id String @id @default(uuid())

  taskId String    @map("task_id")
  task   Task_SPPD @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id")
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  note   String
  status TaskStatus // Snapshot status pada saat catatan dibuat (REVISION_NEEDED / REJECTED)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("task_revision_notes")
}

// =====================================================================
// 8. MODUL PERJALANAN DINAS (TRAVEL MISSION / SPPD / LPJ ENGINE)
// =====================================================================

enum TravelMissionStatus {
  DRAFT
  PLANNED
  ONGOING
  COMPLETED
  LPJ_INCOMPLETE
  LPJ_READY
  ARCHIVED

  @@map("travel_mission_status")
}

model Travel_Mission {
  id String @id @default(uuid())
  displayId String @unique @map("display_id") // PD-20260828-XXXX

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  organizationId String? @map("organization_id")

  // Dasar Penugasan
  assignmentLetterNumber String   @map("assignment_letter_number")
  assignmentLetterDate   DateTime @map("assignment_letter_date")
  title                  String
  purpose                String

  // Lokasi & Destinasi
  origin       String
  destination  String
  destinations Json? // Multi-stops array JSON

  // Waktu Perjalanan
  departureDate DateTime @map("departure_date")
  returnDate    DateTime @map("return_date")

  // Transportasi & Estimasi
  transportMode    String  @map("transport_mode")
  transportDetails String? @map("transport_details")
  status           TravelMissionStatus @default(DRAFT)

  budgetEstimate    Json?   @map("budget_estimate")
  notes             String?
  personnelSnapshot Json?   @map("personnel_snapshot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi balik
  tasks               Task_SPPD[]
  supportingDocuments Supporting_Document[]
  lpjPackages         LPJ_Package[]

  @@index([userId])
  @@index([status])
  @@index([departureDate, returnDate])
  @@map("travel_missions")
}

model Supporting_Document {
  id String @id @default(uuid())

  travelMissionId String         @map("travel_mission_id")
  travelMission   Travel_Mission @relation(fields: [travelMissionId], references: [id], onDelete: Cascade)

  activityId   String? @map("activity_id")
  documentType String  @map("document_type") // ASSIGNMENT_LETTER, SPPD, TICKET, BOARDING_PASS, HOTEL_INVOICE, RECEIPT, OTHER
  title        String
  documentUrl  String  @map("document_url")
  sha256       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([travelMissionId])
  @@index([documentType])
  @@map("supporting_documents")
}

model LPJ_Package {
  id String @id @default(uuid())

  travelMissionId String         @map("travel_mission_id")
  travelMission   Travel_Mission @relation(fields: [travelMissionId], references: [id], onDelete: Cascade)

  packageCode String @unique @map("package_code") // LPJ-20260828-XXXX
  versionNumber Int @default(1) @map("version_number")
  title String

  pdfUrl String? @map("pdf_url")
  packageSha256 String @map("package_sha256")

  completenessScore Decimal @map("completeness_score") @db.Decimal(5, 2)
  totalActualExpense Decimal @map("total_actual_expense") @db.Decimal(15, 2)

  activityCount Int @default(0) @map("activity_count")
  evidenceCount Int @default(0) @map("evidence_count")
  receiptCount  Int @default(0) @map("receipt_count")
  documentCount Int @default(0) @map("document_count")

  contentSnapshot Json @map("content_snapshot")
  status String @default("GENERATED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([travelMissionId])
  @@index([packageCode])
  @@map("lpj_packages")
}

// =====================================================================
// 9. MODUL SUBSCRIPTION & PEMBAYARAN (QRIS / VIRTUAL ACCOUNT)
// =====================================================================
// Satu-satunya sumber kebenaran harga & kuota paket di sisi SERVER -
// lihat src/modules/subscriptions/plan-catalog.ts. Mobile PlanConfig
// (tulap_mobile/lib/features/subscription/data/plan_config.dart) HANYA
// untuk tampilan; harga aktual SELALU dihitung ulang dari sini saat
// checkout, TIDAK PERNAH dipercaya dari client (lihat PaymentsService).
// =====================================================================

enum PlanCode {
  GRATIS
  BASIC
  PRO
  PRO_PLUS

  @@map("plan_code")
}

enum BillingCycle {
  MONTHLY
  ANNUAL

  @@map("billing_cycle")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

enum SubscriptionOwnerType {
  PERSONAL

  @@map("subscription_owner_type")
}

/// Langganan personal user - SATU baris per user (unik lewat userId).
/// SENGAJA tidak memakai `user.isPremium = true` supaya periode &
/// status eksplisit dan future-ready terhadap paket instansi.
model Subscription {
  id String @id @default(uuid())

  ownerType SubscriptionOwnerType @default(PERSONAL) @map("owner_type")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planCode     PlanCode     @default(GRATIS) @map("plan_code")
  billingCycle BillingCycle @default(MONTHLY) @map("billing_cycle")
  status       SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@map("subscriptions")
}

enum PaymentMethod {
  QRIS
  VA

  @@map("payment_method")
}

/// Status transaksi pembayaran ternormalisasi - independen dari istilah
/// internal payment provider manapun (Bagian 9 instruksi payment).
enum PaymentTransactionStatus {
  CREATED
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_transaction_status")
}

/// Satu baris = satu percobaan checkout QRIS/VA. `checkoutAttemptId`
/// (idempotency key dari client) mencegah double-submit membuat dua
/// transaksi provider (Bagian 32 instruksi payment). `publicReference`
/// dipakai sebagai `order_id` provider DAN sebagai nomor yang ditampilkan
/// ke user - collision-safe (uuid), bukan sequential ID database.
model PaymentTransaction {
  id              String @id @default(uuid())
  publicReference String @unique @map("public_reference")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  planCode     PlanCode     @map("plan_code")
  billingCycle BillingCycle @map("billing_cycle")

  // Ditentukan SERVER dari plan-catalog.ts saat checkout dibuat - TIDAK
  // PERNAH dari field `amount` yang dikirim client (lihat Bagian 8).
  amount   Int
  currency String @default("IDR")

  paymentMethod PaymentMethod @map("payment_method")
  provider      String // "MIDTRANS" dst - lihat PAYMENT_PROVIDER env

  providerTransactionId String? @map("provider_transaction_id")
  providerReference     String? @map("provider_reference")

  // Detail pembayaran aktual dari provider - QRIS payload atau nomor VA.
  // BUKAN nilai buatan sendiri (lihat Bagian 11 & 14 - dilarang invent).
  vaBank   String? @map("va_bank")
  vaNumber String? @map("va_number")
  qrString String? @map("qr_string") @db.Text

  status PaymentTransactionStatus @default(CREATED)

  checkoutAttemptId String @unique @map("checkout_attempt_id")

  // Hanya diisi jika provider BENAR-BENAR menyediakan data settlement
  // (Bagian 36) - subscription TIDAK PERNAH bergantung pada kolom ini.
  settlementStatus    String?   @map("settlement_status")
  settlementReference String?   @map("settlement_reference")
  settledAt           DateTime? @map("settled_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  expiresAt   DateTime? @map("expires_at")
  paidAt      DateTime? @map("paid_at")
  failedAt    DateTime? @map("failed_at")
  cancelledAt DateTime? @map("cancelled_at")
  refundedAt  DateTime? @map("refunded_at")

  @@index([userId])
  @@index([status])
  @@map("payment_transactions")
}

/// Dedupe notifikasi webhook provider (Bagian 19 instruksi payment) -
/// terpisah dari idempotency compare-and-set di PaymentTransaction.status
/// supaya notifikasi duplikat bisa dicatat eksplisit sebagai
/// `duplicate_webhook_ignored`, bukan diam-diam diabaikan.
model Processed_Webhook_Event {
  id String @id @default(uuid())

  provider String
  eventId  String @map("event_id")

  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}

