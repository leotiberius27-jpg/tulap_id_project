# =====================================================================
# TULAP.ID - BACKEND ENVIRONMENT VARIABLES (CONTOH)
# Jangan pernah commit file .env asli ke repository!
# =====================================================================

NODE_ENV=development
PORT=3000

# Database (PostgreSQL - wajib region Jakarta sesuai UU PDP No. 27/2022)
DATABASE_URL="postgresql://user:password@localhost:5432/tulap_db?schema=public"

# JWT Secrets - GENERATE dengan: openssl rand -base64 64
JWT_SECRET="ganti_dengan_secret_key_yang_sangat_acak_dan_panjang"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti_dengan_secret_key_berbeda_untuk_refresh_token"
JWT_REFRESH_EXPIRES_IN="7d"

# S3-Compatible Storage (GCP/AWS Region Jakarta)
S3_ENDPOINT="https://storage.jakarta.example.com"
S3_REGION="ap-southeast-3"
S3_BUCKET_NAME="tulap-storage-prod"
S3_PUBLIC_URL_BASE="https://storage.jakarta.example.com/tulap-storage-prod"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Enkripsi data at-rest (AES-256)
ENCRYPTION_KEY="ganti_dengan_32_byte_key_untuk_aes_256"

# Email (SMTP) - untuk "Lupa Kata Sandi"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Tulap.id <no-reply@tulap.id>"

# Google Sign-In (Client ID OAuth 2.0 tipe "Web" dari Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=""

# Sign In with Apple (Services ID dari Apple Developer Program)
APPLE_OAUTH_CLIENT_ID=""

# =====================================================================
# PEMBAYARAN SUBSCRIPTION (QRIS / Virtual Account) - lihat
# src/modules/payments. Server Key JANGAN PERNAH di-commit atau
# dikirim ke client - hanya dipakai server-to-server.
# =====================================================================
PAYMENT_PROVIDER="MIDTRANS"
# "sandbox" untuk development/testing, "production" setelah verifikasi
# kredensial live selesai (lihat RUNBOOK/laporan implementasi payment).
PAYMENT_ENVIRONMENT="sandbox"

# Midtrans Server Key (Settings > Access Keys di dashboard Midtrans -
# gunakan SANDBOX Server Key untuk development).
MIDTRANS_SERVER_KEY=""
